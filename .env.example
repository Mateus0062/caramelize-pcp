# Copie este arquivo para .env.local e preencha os valores.
# NUNCA coloque senhas reais neste arquivo: ele vai para o repositório.

# --- Banco de dados (Supabase / PostgreSQL) ---------------------------------
# Deixe vazio para usar o PostgreSQL embutido (PGlite, em data/pglite) em desenvolvimento.
# Em produção o banco local é bloqueado, a menos que ALLOW_LOCAL_DB="true".
# Em produção/serverless prefira a URL do pooler (Supavisor, porta 6543).
# Depois de configurar, aplique as migrations: npm run db:migrate
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres"

# Certificado da CA do Supabase (Project Settings → Database → SSL Configuration).
# Sem ele a conexão com o Supabase é recusada, pois o certificado é verificado.
DATABASE_SSL_CA_FILE="certs/supabase-ca.crt"
# Alternativa: conteúdo PEM direto na variável (\n no lugar das quebras de linha).
# DATABASE_SSL_CA=""
# Somente desenvolvimento: desliga a verificação do certificado (proibido em produção).
# DATABASE_SSL_INSECURE="true"

# --- Sessão ----------------------------------------------------------------
# Obrigatório. Mínimo de 32 caracteres aleatórios. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# --- Administrador inicial -------------------------------------------------
# Usado apenas quando não existe nenhum usuário. Senha com 12+ caracteres.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador Caramelize"
